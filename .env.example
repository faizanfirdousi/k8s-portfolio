# Application Configuration Example
# Copy this file to .env and configure your environment-specific settings.

# Port for local service execution
PORT=3000

# GitHub Integration (projects service)
GITHUB_USERNAME=faizanfirdousi
# Optional Personal Access Token for GitHub API (recommended in production to avoid rate limits)
# GITHUB_TOKEN=

# DEV.to Integration (blog service)
DEVTO_USERNAME=faizanfirdousi

# Cache TTL (milliseconds)
CACHE_TTL_MS=300000

# Proxy Service (CORS origins: comma-separated URLs; leave empty for same-origin only)
CORS_ALLOWED_ORIGINS=

# Contact form webhook (optional — Discord/Slack/generic JSON endpoint)
# CONTACT_WEBHOOK_URL=https://hooks.example.com/...

# Production TLS domain (used by deploy-to-aws.sh and aws-provision.sh)
# PORTFOLIO_DOMAIN=k8s.example.com
# CERT_MANAGER_EMAIL=you@example.com
