# Application Configuration Example
# Copy this file to .env and configure your environment-specific settings.

# Port for local service execution
PORT=3000

# GitHub Integration (projects service)
GITHUB_USERNAME=faizanfirdousi
# Optional Personal Access Token for GitHub API (recommended in production to avoid rate limits)
# GITHUB_TOKEN=

# DEV.to Integration (blog service)
DEVTO_USERNAME=faizanfirdousi

# Cache TTL (milliseconds)
CACHE_TTL_MS=300000

# Proxy Service (CORS origins: comma-separated URLs or *)
CORS_ALLOWED_ORIGINS=
